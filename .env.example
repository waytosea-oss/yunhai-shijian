PORT=8790
HOST=127.0.0.1

# Optional: proxy an existing service exposing image.jpg, cloud-poem.json and balance.json.
# YUNHAI_UPSTREAM_URL=http://127.0.0.1:8787

# Optional standalone files or an HTTPS image URL.
# YUNHAI_CLOUD_IMAGE=demo/cloud-synthetic.jpg
# YUNHAI_POEM_FILE=runtime/poem.json
# YUNHAI_BALANCE_FILE=/absolute/path/to/balance.json

# Optional AI generation.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
# YUNHAI_CONTEXT_FILE=/absolute/path/to/authoritative-weather-context.txt
# YUNHAI_POEM_OUTPUT=runtime/poem.json
